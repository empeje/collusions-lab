# Copy to `.env` (gitignored) and fill in. NEVER commit real tokens.
# Used by scripts/publish.py and the HF Space publisher.

# GitHub personal access token (scopes: repo) — for creating/pushing the GitHub repo.
GH_TOKEN=

# Hugging Face token (write) — for creating the Space/Dataset and as the Space secret.
HF_TOKEN=

# Optional: override auto-detected account names.
# GITHUB_USERNAME=
# HF_USERNAME=
